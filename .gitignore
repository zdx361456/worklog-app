# ===========================================================================
#  .gitignore —— 工时工资记账 App
#
#  原则：只入库「人能读、机器能重建」的东西。
#        体积巨大且可由源码重建的一切（build/、.dart_tool/、.gradle/）
#        与本机临时区（_scratch/、.workbuddy/）一律排除。
#
#  实测体积（2026-10-14）：worklog-app/app = 5.3G、_scratch = 3.6G
#  排除后实际入库约 56 MB，其中 55 MB 是唯一那份安装包。
# ===========================================================================

# ---- 构建产物（体积最大，绝不入库）----------------------------------------
build/
.dart_tool/
.gradle/
*.iml
.idea/
.cxx/

# ---- 本机 / 内部临时区 -----------------------------------------------------
_scratch/
.workbuddy/
.codebuddy/
*.log
*.genie
flutter_01.log

# ---- Android 本机配置（含本机绝对路径，入别人的库会失效）------------------
local.properties
.flutter-plugins
.flutter-plugins-dependencies

# ---- 签名文件（真签名时绝不入库）------------------------------------------
*.jks
*.keystore

# ---- 交付历史：只保留「最新那一份」，被替换的旧版不入库 -------------------
worklog-app/app/release/*-replaced.apk

# ---- 构建脚本的历史备份（本地留档即可）------------------------------------
build_apk.bat.bak*
build_apk.bat.bak2-*
build_apk.bat.bak3-*
build_apk.bat.bak4-*
build_apk.bat.bak5-*

# ---- 系统杂物 --------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
